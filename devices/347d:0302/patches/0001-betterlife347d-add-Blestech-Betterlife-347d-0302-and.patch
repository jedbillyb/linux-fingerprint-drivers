+0xe4,0xb3,0x1c,0xa9,0xc9,0x08,0xe8,0x95,0x80,0xdf,0x94,0xfa,0x75,0x8f,0x3f,0xa6,
+0x47,0x07,0xa7,0xfc,0xf3,0x73,0x17,0xba,0x83,0x59,0x3c,0x19,0xe6,0x85,0x4f,0xa8,
+0x68,0x6b,0x81,0xb2,0x71,0x64,0xda,0x8b,0xf8,0xeb,0x0f,0x4b,0x70,0x56,0x9d,0x35,
+0x1e,0x24,0x0e,0x5e,0x63,0x58,0xd1,0xa2,0x25,0x22,0x7c,0x3b,0x01,0x21,0x78,0x87,
+0xd4,0x00,0x46,0x57,0x9f,0xd3,0x27,0x52,0x4c,0x36,0x02,0xe7,0xa0,0xc4,0xc8,0x9e,
+0xea,0xbf,0x8a,0xd2,0x40,0xc7,0x38,0xb5,0xa3,0xf7,0xf2,0xce,0xf9,0x61,0x15,0xa1,
+0xe0,0xae,0x5d,0xa4,0x9b,0x34,0x1a,0x55,0xad,0x93,0x32,0x30,0xf5,0x8c,0xb1,0xe3,
+0x1d,0xf6,0xe2,0x2e,0x82,0x66,0xca,0x60,0xc0,0x29,0x23,0xab,0x0d,0x53,0x4e,0x6f,
+0xd5,0xdb,0x37,0x45,0xde,0xfd,0x8e,0x2f,0x03,0xff,0x6a,0x72,0x6d,0x6c,0x5b,0x51,
+0x8d,0x1b,0xaf,0x92,0xbb,0xdd,0xbc,0x7f,0x11,0xd9,0x5c,0x41,0x1f,0x10,0x5a,0xd8,
+0x0a,0xc1,0x31,0x88,0xa5,0xcd,0x7b,0xbd,0x2d,0x74,0xd0,0x12,0xb8,0xe5,0xb4,0xb0,
+0x89,0x69,0x97,0x4a,0x0c,0x96,0x77,0x7e,0x65,0xb9,0xf1,0x09,0xc5,0x6e,0xc6,0x84,
+0x18,0xf0,0x7d,0xec,0x3a,0xdc,0x4d,0x20,0x79,0xee,0x5f,0x3e,0xd7,0xcb,0x39,0x48};
+
+static const uint32_t FK[4] = {0xa3b1bac6,0x56aa3350,0x677d9197,0xb27022dc};
+static const uint32_t CK[32] = {
+0x00070e15,0x1c232a31,0x383f464d,0x545b6269,0x70777e85,0x8c939aa1,0xa8afb6bd,0xc4cbd2d9,
+0xe0e7eef5,0xfc030a11,0x181f262d,0x343b4249,0x50575e65,0x6c737a81,0x888f969d,0xa4abb2b9,
+0xc0c7ced5,0xdce3eaf1,0xf8ff060d,0x141b2229,0x30373e45,0x4c535a61,0x686f767d,0x848b9299,
+0xa0a7aeb5,0xbcc3cad1,0xd8dfe6ed,0xf4fb0209,0x10171e25,0x2c333a41,0x484f565d,0x646b7279};
+
+static uint32_t rol(uint32_t x, int n) { return (x<<n)|(x>>(32-n)); }
+static uint32_t tau(uint32_t a) {
+    return (uint32_t)S[a>>24]<<24 | (uint32_t)S[(a>>16)&0xff]<<16 | (uint32_t)S[(a>>8)&0xff]<<8 | S[a&0xff];
+}
+static uint32_t L(uint32_t b)  { return b ^ rol(b,2) ^ rol(b,10) ^ rol(b,18) ^ rol(b,24); }
+static uint32_t Lk(uint32_t b) { return b ^ rol(b,13) ^ rol(b,23); }
+static uint32_t ld(const uint8_t *p){return (uint32_t)p[0]<<24|(uint32_t)p[1]<<16|(uint32_t)p[2]<<8|p[3];}
+static void st(uint8_t *p, uint32_t v){p[0]=v>>24;p[1]=v>>16;p[2]=v>>8;p[3]=v;}
+
+void sm4_key_schedule(const uint8_t key[16], uint32_t rk[32], int encrypt) {
+    uint32_t k[4];
+    for (int i=0;i<4;i++) k[i]=ld(key+4*i)^FK[i];
+    uint32_t tmp[32];
+    for (int i=0;i<32;i++){ k[i&3]^=Lk(tau(k[(i+1)&3]^k[(i+2)&3]^k[(i+3)&3]^CK[i])); tmp[i]=k[i&3]; }
+    if (encrypt) for(int i=0;i<32;i++) rk[i]=tmp[i];
+    else for(int i=0;i<32;i++) rk[i]=tmp[31-i];
+}
+
+void sm4_crypt_block(const uint32_t rk[32], const uint8_t in[16], uint8_t out[16]) {
+    uint32_t x[4];
+    for (int i=0;i<4;i++) x[i]=ld(in+4*i);
+    for (int i=0;i<32;i++){ uint32_t t=x[0]^L(tau(x[1]^x[2]^x[3]^rk[i])); x[0]=x[1];x[1]=x[2];x[2]=x[3];x[3]=t; }
+    st(out,x[3]); st(out+4,x[2]); st(out+8,x[1]); st(out+12,x[0]);
+}
+
+#ifdef SM4_TEST
+#include <stdio.h>
+#include <string.h>
+int main(void){
+    uint8_t key[16],pt[16],ct[16],dt[16]; uint32_t ek[32],dk[32];
+    for(int i=0;i<16;i++){ key[i]=pt[i]=(i<8?(0x01+0x22*i):0); }
+    uint8_t v[16]={0x01,0x23,0x45,0x67,0x89,0xab,0xcd,0xef,0xfe,0xdc,0xba,0x98,0x76,0x54,0x32,0x10};
+    memcpy(key,v,16); memcpy(pt,v,16);
+    sm4_key_schedule(key,ek,1); sm4_key_schedule(key,dk,0);
+    sm4_crypt_block(ek,pt,ct); sm4_crypt_block(dk,ct,dt);
+    const char*want="681edf34d206965e86b3e94f536e4246";
+    char g[33]; for(int i=0;i<16;i++) sprintf(g+2*i,"%02x",ct[i]);
+    printf("SM4 enc=%s\n%s\n", g, strcmp(g,want)?"FAIL-ENC":"PASS-ENC");
+    printf("roundtrip=%s\n", memcmp(pt,dt,16)?"FAIL":"PASS");
+    return strcmp(g,want)||memcmp(pt,dt,16);
+}
+#endif
