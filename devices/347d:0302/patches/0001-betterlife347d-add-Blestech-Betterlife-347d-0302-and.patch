+/* SM4 block cipher (GM/T 0002-2012). Self-test under -DSM4_TEST. */
+#include <stdint.h>
+#include "sm4.h"
+
+static const uint8_t S[256] = {
+0xd6,0x90,0xe9,0xfe,0xcc,0xe1,0x3d,0xb7,0x16,0xb6,0x14,0xc2,0x28,0xfb,0x2c,0x05,
