+static guint8
+elanmoc2_cmd_ep_in_for_device (FpiDeviceElanMoC2 *self, const Elanmoc2Cmd *cmd)
+{
+  if ((self->dev_type & ELANMOC2_QUIRK_USE_EP83) &&
+      (cmd == &cmd_identify || cmd == &cmd_enroll))
+    return ELANMOC2_EP_MOC_CMD_IN_83;
+
+  return cmd->ep_in;
+}
